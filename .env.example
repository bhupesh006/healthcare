# ==============================================================
# Vercel & Production Environment Variables for Health+ Platform
# ==============================================================

# MongoDB Connection String (Required in Vercel Environment Variables)
# Create a free MongoDB Atlas database at https://mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/healthplus?retryWrites=true&w=majority

# Secret key for JWT tokens (Required)
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Environment
NODE_ENV=production

# (Optional) If frontend is hosted separately from backend:
# VITE_API_URL=https://your-backend-domain.com
# CLIENT_URL=https://your-frontend-domain.vercel.app

